{
  "name": "multifolio",
  "version": "1.0.6",
  "description": "MultiFolio - A continuous multi-column workspace for seamless reading and editing",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run lint:styles && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json package.json",
    "lint": "eslint .",
    "lint:styles": "stylelint styles.css"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "dual-pane",
    "reading"
  ],
  "author": "Li Yifan",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "2.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1"
  }
}
