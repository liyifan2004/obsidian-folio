{
  "name": "multifolio",
  "version": "1.0.3",
  "description": "MultiFolio - A continuous multi-column workspace for seamless reading and editing",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint main.ts src package.json",
    "lint:styles": "stylelint styles.css"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "dual-pane",
    "reading"
  ],
  "author": "Li Yifan",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "2.4.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0"
  }
}
